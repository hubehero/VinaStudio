    "@vitejs/plugin-vue": "^6.0.10",
    "jsdom": "^31.0.0",
    "sass-embedded": "^1.108.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14"
