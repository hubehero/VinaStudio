+
+    receptor = tmp_path / "receptor.pdbqt"
+    receptor.write_text("REMARK test receptor\n", encoding="utf-8")
+
+    response = client.post(
+        "/api/box/write-maps",
+        json={
+            "receptorPath": str(receptor),
+            "center": [15.19, 53.903, 16.917],
+            "size": [16.664, 20.0, 20.0],
+            "outputPrefix": str(workspace_root() / "maps-functional" / "receptor"),
+        },
+    )
+
+    assert response.status_code == 422, response.text
+    assert "forceEvenVoxels" in response.json()["detail"]
