  "properties": {
    "schemaVersion": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schemaversion",
      "type": "string"
    },
    "software": {
      "$ref": "#/$defs/SoftwareInfo"
    },
    "engine": {
      "$ref": "#/$defs/EngineInfo"
    },
    "inputs": {
      "$ref": "#/$defs/InputFiles"
    },
    "preparation": {
      "$ref": "#/$defs/PreparationBlock"
    },
    "searchSpace": {
      "$ref": "#/$defs/SearchSpace"
    },
    "parameters": {
      "$ref": "#/$defs/ResultParameters"
    },
    "artifacts": {
      "$ref": "#/$defs/Artifacts"
    },
    "poses": {
      "items": {
        "$ref": "#/$defs/PoseRecord"
      },
      "title": "Poses",
      "type": "array"
    },
    "validation": {
      "$ref": "#/$defs/ValidationBlock"
    },
    "analysis": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Analysis"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    }
  },
  "required": [
    "software",
    "engine",
    "inputs",
    "preparation",
    "searchSpace",
    "parameters",
    "provenance"
  ],
  "title": "DockResult",
  "type": "object"
}
